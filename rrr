public static void SendToEndpointFireAndForget(string url, string sendMessage)
{
    Task.Run(async () =>
    {
        try
        {
            await SendToEndpointAsync(url, sendMessage).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            // Replace with your real logging framework
            System.Diagnostics.Trace.TraceError(
                "Fire-and-forget converter call failed. Url={0}. Error={1}",
                url,
                ex);
        }
    });
}

private static async Task<string> SendToEndpointAsync(string url, string sendMessage)
{
    var client = MessageConverterHttpClient.Instance;

    using (var content = new StringContent(sendMessage ?? "", Encoding.UTF8, "application/xml"))
    using (var response = await client.PostAsync(url, content).ConfigureAwait(false))
    {
        // Optional but recommended:
        response.EnsureSuccessStatusCode();

        var body = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
        return body;
    }
}
