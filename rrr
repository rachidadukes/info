Private Sub HandleBothEndpointsFireAndForget(xml As String)
    Dim url As String = GetConverterEndpointUrl()

    If String.IsNullOrWhiteSpace(url) Then
        Exit Sub
    End If

    MessageConverterSender.SendToEndpointFireAndForget(url, xml)
End Sub

====================
Private Function GetConverterEndpointUrl() As String
    Return ConfigurationManager.AppSettings("ConverterUrl")
End Function


