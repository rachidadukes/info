@page "/members-by-access-number"
@rendermode InteractiveServer
@using System.Text.Json
@inject LegalHoldAdmin.Services.MembersByAccessNumberApi MembersByAccessNumberApi

<h1>Members By Access Number</h1>

<section class="card">
    <h2>Member Search</h2>

    <div class="grid two">
        <label>
            Access Number
            <input @bind="accessNumber" @bind:event="oninput" />
        </label>
    </div>

    <div class="actions">
        <button @onclick="CallMemberApiAsync" disabled="@isCallingMemberApi">
            @(isCallingMemberApi ? "Searching..." : "Search Members")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(memberApiError))
    {
        <div class="alert error mt-3" role="alert">@memberApiError</div>
    }
</section>

<section class="card">
    <h2>Members (@members.Count)</h2>

    @if (isCallingMemberApi)
    {
        <p>Loading...</p>
    }
    else if (members.Count == 0)
    {
        <p class="muted">No members yet. Enter an access number, then click Search Members.</p>
    }
    else
    {
        <RadzenDataGrid Data="@members"
                        TItem="MemberSearchMember"
                        AllowPaging="true"
                        AllowSorting="true"
                        PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="AccessNumber"
                                      Title="Access Number" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="DisplayName"
                                      Title="Name" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="MembershipStatus"
                                      Title="Status" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="MembershipType"
                                      Title="Type" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="DateOfBirth"
                                      Title="DOB" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="PrimaryEmail"
                                      Title="Email" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="PrimaryPhone"
                                      Title="Phone" />
            </Columns>
        </RadzenDataGrid>
    }
</section>

@code {
    private bool isCallingMemberApi;
    private string? memberApiError;
    private string? accessNumber;
    private List<MemberSearchMember> members = new();

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private async Task CallMemberApiAsync()
    {
        isCallingMemberApi = true;
        memberApiError = null;
        members.Clear();

        try
        {
            if (string.IsNullOrWhiteSpace(accessNumber))
            {
                memberApiError = "Enter access number before calling Member Search.";
                return;
            }

            var result = await MembersByAccessNumberApi.SearchMemberAsync(accessNumber.Trim());

            memberApiError = result.IsSuccess ? null : result.ErrorMessage;

            if (!string.IsNullOrWhiteSpace(result.Data))
            {
                var memberSearchResponse = JsonSerializer.Deserialize<MemberSearchResponse>(
                    result.Data,
                    JsonOptions);

                members = memberSearchResponse?.Members ?? new List<MemberSearchMember>();
            }
        }
        catch (Exception ex)
        {
            memberApiError = ex.Message;
        }
        finally
        {
            isCallingMemberApi = false;
        }
    }
}
