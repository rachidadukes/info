public static void SendToEndpointFireAndForget(string url, string sendMessage)
{
    Task.Run(async () =>
    {
        try
        {
            await SendToEndpointAsync(url, sendMessage).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            // TODO: log exception (VERY important in fire-and-forget)
        }
    });
}
