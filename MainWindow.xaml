<Window x:Class="WpfApiTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApiTester"
        mc:Ignorable="d"
        Title="Api Tester"
        Width="1180"
        Height="960"
        MinWidth="1000"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>
        <!-- Shared style for all three API buttons.
             Uses a custom ControlTemplate so WPF never overrides Foreground when disabled. -->
        <Style x:Key="ApiButtonStyle" TargetType="Button">
            <Setter Property="Foreground"   Value="White" />
            <Setter Property="FontSize"     Value="15" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="Height"       Value="44" />
            <Setter Property="Width"        Value="200" />
            <Setter Property="Padding"      Value="14,10" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Enabled = full blue -->
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background"  Value="#2F80ED" />
                    <Setter Property="BorderBrush" Value="#2F80ED" />
                </Trigger>
                <!-- Disabled = muted blue, text stays white -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background"  Value="#7AADD6" />
                    <Setter Property="BorderBrush" Value="#7AADD6" />
                    <Setter Property="Cursor"      Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="18"
                Background="#17324D"
                CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="API Tester" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#D6E5F5"
                           Text="Load saved XML requests from SQLite, send them to the API, and inspect the formatted XML response." />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    FontSize="14">
            <TabItem Header="Requests">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="110" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Transaction Type ComboBox -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <TextBlock Text="Transaction Type:"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#183B56"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <ComboBox x:Name="TransactionTypeComboBox"
                                  Width="320"
                                  FontSize="13"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="TransactionTypeComboBox_SelectionChanged" />
                    </StackPanel>

                    <ListView x:Name="UrlListBox"
                              Grid.Row="1"
                              Margin="0,0,0,14"
                              Height="100"
                              FontSize="13"
                              SelectionMode="Single"
                              SelectionChanged="UrlListBox_OnSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Type"
                                                Width="160"
                                                DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="Endpoint"
                                                Width="580"
                                                DisplayMemberBinding="{Binding Endpoint}" />
                                <GridViewColumn Header="Environment"
                                                Width="120"
                                                DisplayMemberBinding="{Binding Environment}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ListView x:Name="RequestsListBox"
                              Grid.Row="2"
                              Margin="0,0,0,18"
                              FontFamily="Consolas"
                              FontSize="14"
                              SelectionChanged="RequestsListBox_OnSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Description"
                                                Width="500"
                                                DisplayMemberBinding="{Binding DisplayText}" />
                                <GridViewColumn Header="Type"
                                                Width="180"
                                                DisplayMemberBinding="{Binding Type}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="3"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#183B56"
                               Text="Selected Request" />

                    <RichTextBox x:Name="SelectedRequestRichTextBox"
                                 Grid.Row="4"
                                 Margin="0,12,0,16"
                                 Padding="12"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto">
                        <RichTextBox.Document>
                            <FlowDocument PagePadding="0" />
                        </RichTextBox.Document>
                    </RichTextBox>

                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0">

                        <Button x:Name="CDdepositButton"
                                Margin="0,0,10,0"
                                Style="{StaticResource ApiButtonStyle}"
                                Content="CD Deposit"
                                IsEnabled="False"
                                Click="CDdepositButton_OnClick" />

                        <Button x:Name="MemberSearchButton"
                                Margin="0,0,10,0"
                                Style="{StaticResource ApiButtonStyle}"
                                Content="Member Search"
                                IsEnabled="False"
                                Click="MemberSearchButton_OnClick" />

                        <Button x:Name="MemberInfoButton"
                                Style="{StaticResource ApiButtonStyle}"
                                Content="Member Profile"
                                IsEnabled="False"
                                Click="MemberInfoButton_OnClick" />

                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="ResponseTab" Header="Response">
                <Grid Margin="14">
                    <TextBox x:Name="ResponseTextBox"
                             Padding="12"
                             FontFamily="Consolas"
                             FontSize="14"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <local:HistoryControl x:Name="HistoryControl" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="12,10"
                Background="White"
                BorderBrush="#D6E0EA"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#35546E"
                       Text="Idle" />
        </Border>
    </Grid>
</Window>
