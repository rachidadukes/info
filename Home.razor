@page "/"
@inject PrototypeData Data
<PageTitle>Overview | Encore</PageTitle>
<p class="eyebrow">RELEASE COORDINATION</p>
<p class="intro">See which builds are planned, where testing will happen, and what needs attention.</p>
<div class="metric-grid">
    <a class="metric" href="deployments"><span>Deployments</span><strong>@Data.Deployments.Count</strong><small>Release and environment assignments</small></a>
    <a class="metric" href="test-machines"><span>Test machines</span><strong>@Data.Machines.Count</strong><small>Across Test and Staging</small></a>
    <a class="metric" href="testing-windows"><span>Testing windows</span><strong>@Data.Windows.Count</strong><small>Scheduled SQA and UAT sessions</small></a>
    <a class="metric attention" href="testing-windows"><span>Reservation conflicts</span><strong>@Data.Conflicts.Count</strong><small>Shared machines need review</small></a>
</div>
<section class="panel"><h2>Needs attention</h2>
@foreach (var conflict in Data.Conflicts)
{
    <p><strong>@string.Join(", ", conflict.Machines)</strong> is reserved by both @conflict.First.Activity and @conflict.Second.Activity on October 14, 2026, from 11:00 AM to noon EDT.</p>
}
<RadzenButton Text="Review testing windows" Icon="calendar_month" Click="@(() => Navigation.NavigateTo("testing-windows"))" />
</section>
@inject NavigationManager Navigation
