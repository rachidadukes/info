@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@inject LegalHoldAdmin.Services.MemberApiClient MemberApiClient

<h1>Legal Hold Administration</h1>

<p><a class="button" href="/legal-holds">Open Legal Holds</a></p>

<section class="member-api-test">
    <h2>Member API Test</h2>

    <div class="grid two">
        <label>
            First Name
            <input @bind="firstName" @bind:event="oninput" />
        </label>

        <label>
            Last Name
            <input @bind="lastName" @bind:event="oninput" />
        </label>
    </div>

    <button class="btn btn-primary" @onclick="CallMemberApiAsync" disabled="@isCallingMemberApi">
        @(isCallingMemberApi ? "Calling..." : "Call Member Search")
    </button>

    @if (!string.IsNullOrWhiteSpace(memberApiError))
    {
        <div class="alert alert-danger mt-3" role="alert">@memberApiError</div>
    }

    @if (members.Count > 0)
    {
        <h3 class="mt-4">Members (@members.Count)</h3>

        <RadzenDataGrid Data="@members"
                        TItem="MemberSearchMember"
                        AllowPaging="true"
                        AllowSorting="true"
                        PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="AccessNumber"
                                      Title="Access Number" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="DisplayName"
                                      Title="Name" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="MembershipStatus"
                                      Title="Status" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="MembershipType"
                                      Title="Type" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="DateOfBirth"
                                      Title="DOB" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="PrimaryEmail"
                                      Title="Email" />
                <RadzenDataGridColumn TItem="MemberSearchMember"
                                      Property="PrimaryPhone"
                                      Title="Phone" />
            </Columns>
        </RadzenDataGrid>
    }
</section>

@code {
    private bool isCallingMemberApi;
    private string? memberApiError;
    private string? firstName;
    private string? lastName;
    private List<MemberSearchMember> members = new();

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private async Task CallMemberApiAsync()
    {
        isCallingMemberApi = true;
        memberApiError = null;
        members.Clear();

        try
        {
            if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
            {
                memberApiError = "Enter first and last name before calling Member Search.";
                return;
            }

            var result = await MemberApiClient.SearchMemberAsync(firstName.Trim(), lastName.Trim());

            memberApiError = result.IsSuccess ? null : result.ErrorMessage;

            if (!string.IsNullOrWhiteSpace(result.Data))
            {
                var memberSearchResponse = JsonSerializer.Deserialize<MemberSearchResponse>(
                    result.Data,
                    JsonOptions);

                members = memberSearchResponse?.Members ?? new List<MemberSearchMember>();
            }
        }
        catch (Exception ex)
        {
            memberApiError = ex.Message;
        }
        finally
        {
            isCallingMemberApi = false;
        }
    }
}
