using Microsoft.Data.Sqlite;
using System.Collections.ObjectModel;
using System.Windows;
using System.Windows.Controls;

namespace WpfApiTester
{
    public partial class RequestsComparisonControl : UserControl
    {
        private readonly ObservableCollection<RequestListItem> _requests = new();

        public RequestsComparisonControl()
        {
            InitializeComponent();

            RequestsListBox.ItemsSource = _requests;

            Loaded += RequestsComparisonControl_Loaded;
        }

        private void RequestsComparisonControl_Loaded(object sender, RoutedEventArgs e)
        {
            LoadRequests();
        }

        private void LoadRequests()
        {
            _requests.Clear();

            var dbPath = "Requests.sqlite";

            var connectionString = $"Data Source={dbPath}";

            using var connection = new SqliteConnection(connectionString);
            connection.Open();

            var sql = """
                      SELECT 
                          ID,
                          Description,
                          Request,
                          Type,
                          KeyFields
                      FROM Requests
                      ORDER BY ID DESC;
                      """;

            using var command = new SqliteCommand(sql, connection);
            using var reader = command.ExecuteReader();

            while (reader.Read())
            {
                _requests.Add(new RequestListItem
                {
                    Id = reader.GetInt64(reader.GetOrdinal("ID")),
                    Description = reader["Description"]?.ToString() ?? string.Empty,
                    Request = reader["Request"]?.ToString() ?? string.Empty,
                    Type = reader["Type"]?.ToString() ?? string.Empty,
                    KeyFields = reader["KeyFields"]?.ToString() ?? string.Empty
                });
            }
        }

        private void RequestsListBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            var selectedItems = RequestsListBox.SelectedItems
                .Cast<RequestListItem>()
                .Take(2)
                .ToList();

            LeftRequestTextBox.Text = selectedItems.Count > 0
                ? selectedItems[0].Request
                : string.Empty;

            RightRequestTextBox.Text = selectedItems.Count > 1
                ? selectedItems[1].Request
                : string.Empty;
        }
    }

    public class RequestListItem
    {
        public long Id { get; set; }

        public string Description { get; set; } = string.Empty;

        public string Request { get; set; } = string.Empty;

        public string Type { get; set; } = string.Empty;

        public string KeyFields { get; set; } = string.Empty;
    }
}
