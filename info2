var result = (
    from ld in dbContext.LogDetails
    join rr in dbContext.RequestResponse
        on ld.LogId equals rr.LogId
    select new
    {
        LogId = ld.LogId,
        AccountNumber = ld.AccountNumber,
        FirstName = ld.FirstName,
        LastName = ld.LastName,
        Request = rr.Request,
        Response = rr.Response,
        Environment = rr.Environment,
        DateTimeStamp = rr.DateTimeStamp
    })
    .ToList();
