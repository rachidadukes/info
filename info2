

private async Task LoadLatestResponseAsync(RequestItem item)
{
    if (!File.Exists(_databasePath))
        return;

    try
    {
        await using var db = new RequestsDbContext(_databasePath);

        var latestResponse = await db.Responses
            .Where(r =>
                r.Description == item.Description &&
                r.Type == item.Type &&
                r.Environment == item.Environment)
            .OrderByDescending(r => r.Id)
            .FirstOrDefaultAsync();

        if (latestResponse is null)
            return;

        TimestampLabel.Text = latestResponse.DateStamp ?? string.Empty;

        StatusLabel.Text = latestResponse.StatusCode.HasValue
            ? $"| {latestResponse.StatusCode} {latestResponse.StatusPhrase}"
            : string.Empty;

        RequestDetailTextBox.Text = FormatXmlIfPossible(latestResponse.Request ?? string.Empty);
        ResponseDetailTextBox.Text = FormatXmlIfPossible(latestResponse.Response ?? string.Empty);
    }
    catch (Exception ex)
    {
        MessageBox.Show(
            ex.Message,
            "Error Loading Response",
            MessageBoxButton.OK,
            MessageBoxImage.Error);
    }
}

