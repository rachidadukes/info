
sSendBuf = RemoveLeadingZerosFromAcctId(sSendBuf)

Imports System.Xml.Linq

Public Function RemoveLeadingZerosFromAcctId(xmlString As String) As String
    Dim doc As XDocument = XDocument.Parse(xmlString)

    ' Find AcctId node
    Dim acctIdElement = doc.Descendants("AcctId").FirstOrDefault()

    If acctIdElement IsNot Nothing Then
        Dim originalValue As String = acctIdElement.Value

        ' Remove leading zeros
        Dim cleanedValue As String = originalValue.TrimStart("0"c)

        ' Edge case: if all zeros → keep one zero
        If String.IsNullOrEmpty(cleanedValue) Then
            cleanedValue = "0"
        End If

        acctIdElement.Value = cleanedValue
    End If

    Return doc.ToString()
End Function


