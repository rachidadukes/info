private ResponseStatusFields ExtractResponseStatusFields(string message)
{
    return new ResponseStatusFields
    {
        Severity = ExtractTagValue(message, "Severity"),
        StatusCode = ExtractTagValue(message, "StatusCode"),
        StatusDesc = ExtractTagValue(message, "StatusDesc"),
        ResponseCode = ExtractTagValue(message, "ResponseCode"),

        Status = ExtractSimpleStatusValue(message),
        StatusDescription = ExtractTagValue(message, "StatusDescription"),

        TransactionStatus = ExtractTagValue(message, "transactionStatus")
    };
}
