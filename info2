private static void WriteElement(XmlReader reader, Paragraph paragraph, int depth)
{
    var elementName = reader.Name;
    var attributes = GetAttributes(reader);
    var isHighlighted = HighlightedElementNames.Contains(elementName);

    var indent = new string(' ', depth * 4);

    if (reader.IsEmptyElement)
    {
        var run = new Run($"{indent}<{elementName}{attributes} />");
        ApplyTagStyle(run, isHighlighted);

        paragraph.Inlines.Add(run);
        paragraph.Inlines.Add(new LineBreak());
        return;
    }

    // 🔥 LOOK AHEAD
    if (reader.Read() && reader.NodeType == XmlNodeType.Text)
    {
        var value = reader.Value;

        // Move to end element
        if (reader.Read() && reader.NodeType == XmlNodeType.EndElement)
        {
            // ✅ INLINE rendering (this removes the extra space issue)
            var openTag = new Run($"{indent}<{elementName}{attributes}>");
            var valueRun = new Run(value);
            var closeTag = new Run($"</{elementName}>");

            ApplyTagStyle(openTag, isHighlighted);
            ApplyTagStyle(closeTag, isHighlighted);

            if (isHighlighted)
                valueRun.FontWeight = FontWeights.Bold;

            paragraph.Inlines.Add(openTag);
            paragraph.Inlines.Add(valueRun);
            paragraph.Inlines.Add(closeTag);
            paragraph.Inlines.Add(new LineBreak());

            return;
        }
    }

    // fallback (complex node)
    var fallback = new Run($"{indent}<{elementName}{attributes}>");
    ApplyTagStyle(fallback, isHighlighted);

    paragraph.Inlines.Add(fallback);
    paragraph.Inlines.Add(new LineBreak());
}
