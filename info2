
Private Sub SendToConverterEndpoint2(ByRef xml As String, ByRef response As String)

    Dim hostRouting As NameValueCollection =
        CType(ConfigurationManager.GetSection("hostRouting"), NameValueCollection)

    If hostRouting Is Nothing Then
        Throw New ConfigurationErrorsException("Missing hostRouting section.")
    End If

    Dim endpointUrl As String =
        hostRouting(MessageConverterValues.ConfigKeys.MessageConverterURL)

    If String.IsNullOrWhiteSpace(endpointUrl) Then
        Throw New ConfigurationErrorsException("Missing MessageConverterURL in hostRouting.")
    End If

    response = MessageConverterModule.TrySendToEndpoint(endpointUrl, xml)

End Sub

