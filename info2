private async Task<string> GetLegacyResponseAsXmlAsync(string requestXml, string endpoint)
{
    try
    {
        MemberTransactionWsClient client = new MemberTransactionWsClient();
        client.Endpoint.Address = new EndpointAddress(endpoint);

        SearchMemberRq inqRq = XmlConverter.Deserialize<SearchMemberRq>(requestXml);

        SearchForMemberResponseMessage responseMessage =
            await client.searchForMemberAsync(inqRq);

        SearchMemberRs result = responseMessage.SearchMemberRs;

        return XmlHelper.ToXmlString(result);
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex.Message);
        return string.Empty;
    }
}
