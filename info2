@if (alerts?.Any() == true)
{
    <RadzenLabel Text="Alerts" Style="color:red; font-weight:300" />

    <RadzenDataGrid Data="@alerts"
                    TItem="string"
                    AllowFiltering="true"
                    AllowPaging="true"
                    PageSize="8"
                    AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="string" Title="Alert">
                <Template Context="alert">
                    @alert
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
