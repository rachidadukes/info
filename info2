private string HighlightTranCodeValueInXml(string xml)
{
    if (string.IsNullOrWhiteSpace(xml))
        return xml;

    return xml.Replace(
        "<TranCode>",
        "<TranCode><HighlightedTranCode>")
        .Replace(
        "</TranCode>",
        "</HighlightedTranCode></TranCode>");
}


==========================

private void DisplayRequestXml(string xml)
{
    string updatedXml = HighlightTranCodeValueInXml(xml);

    SelectedRequestRichTextBox.Document =
        _xmlFormatter.FormatXml(
            XmlRichTextFormatter.FormatXmlIfPossible(updatedXml));
}


