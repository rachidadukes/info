private static bool IsValidXml(string xml)
{
    if (string.IsNullOrWhiteSpace(xml))
        return false;

    try
    {
        using var reader = XmlReader.Create(new StringReader(xml));
        while (reader.Read()) { }
        return true;
    }
    catch (XmlException)
    {
        return false;
    }
}
