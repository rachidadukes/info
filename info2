public static CD_DepositResponseDTO MapCD_Deposit(
    this CD_DepositRs response)
{
    var dto = new CD_DepositResponseDTO();

    var corrections = response?.FinancialPostingServiceInfo?.Corrections;

    if (corrections?.CorrectionInd == null)
        return dto;

    dto.TranCode = corrections.CorrectionInd.TranCode;
    dto.FileId = corrections.CorrectionInd.FileId;
    dto.UId = corrections.CorrectionInd.UId;

    return dto;
}

public class CD_DepositResponseDTO
{
    public int TranCode { get; set; }
    public int FileId { get; set; }
    public string? UId { get; set; }
}
