private static string BuildVerifiedAcctdUrl(
    string path,
    string? environment,
    bool? verified,
    int skip,
    int take,
    string? filter,
    string? orderBy)
{
    var queryParts = new List<string>();

    if (!string.IsNullOrWhiteSpace(environment))
    {
        queryParts.Add($"environment={Uri.EscapeDataString(environment)}");
    }

    if (verified.HasValue)
    {
        queryParts.Add($"verified={verified.Value}");
    }

    queryParts.Add($"skip={skip}");
    queryParts.Add($"take={take}");

    if (!string.IsNullOrWhiteSpace(filter))
    {
        queryParts.Add($"filter={Uri.EscapeDataString(filter)}");
    }

    if (!string.IsNullOrWhiteSpace(orderBy))
    {
        queryParts.Add($"orderBy={Uri.EscapeDataString(orderBy)}");
    }

    return queryParts.Count == 0
        ? path
        : $"{path}?{string.Join("&", queryParts)}";
}
