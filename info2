private async Task LoadAccounts(LoadDataArgs args)
{
    try
    {
        ErrorMessage = "";

        var skip = args.Skip ?? 0;
        var take = args.Top ?? 10;

        var result = await Api.GetVerifiedAccountNumbersAsync(
            selectedEnvironment,
            Verified,
            skip: skip,
            take: take);

        AllAccountNumbers = result.Data
            .Select(x =>
            {
                x.Environment = x.Environment?.Trim().ToUpperInvariant();
                return x;
            })
            .ToList();

        accountsCount = result.Count;
    }
    catch (Exception ex)
    {
        ErrorMessage = $"Account numbers load failed: {ex.Message}";
    }
}
