public static void SetRichTextBoxTextWithHighlight(
    RichTextBox richTextBox,
    string text,
    string tagName)
{
    richTextBox.Document.Blocks.Clear();

    var paragraph = new Paragraph();
    richTextBox.Document.Blocks.Add(paragraph);

    if (string.IsNullOrWhiteSpace(text))
        return;

    if (string.IsNullOrWhiteSpace(tagName))
    {
        paragraph.Inlines.Add(new Run(text));
        return;
    }

    int currentIndex = 0;
    int matchIndex;

    while ((matchIndex = text.IndexOf(tagName, currentIndex,
               StringComparison.OrdinalIgnoreCase)) >= 0)
    {
        // normal text
        if (matchIndex > currentIndex)
        {
            paragraph.Inlines.Add(
                new Run(text.Substring(currentIndex,
                matchIndex - currentIndex)));
        }

        // highlighted text
        paragraph.Inlines.Add(
            new Run(text.Substring(matchIndex, tagName.Length))
            {
                Foreground = Brushes.Red,
                Background = Brushes.Yellow,
                FontWeight = FontWeights.Bold
            });

        currentIndex = matchIndex + tagName.Length;
    }

    // remaining text
    if (currentIndex < text.Length)
    {
        paragraph.Inlines.Add(
            new Run(text.Substring(currentIndex)));
    }
}
