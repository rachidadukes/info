public async Task SaveNewRequestResponse(List<RequestResponseModel> newLogs)
{
    try
    {
        OpenSQLiteDatabase openDb = new OpenSQLiteDatabase();
        var dbContext = openDb.OpenDatabase();

        var newRequestResponses = new List<RequestResponseModel>();

        foreach (var nums in newLogs)
        {
            var newLog = new RequestResponseModel
            {
                LogId = nums.LogId,
                Request = nums.Request,
                Response = nums.Response,
                Environment = nums.Environment,
                UserID = nums.UserID,
                DateTimeStamp = nums.DateTimeStamp
            };

            newRequestResponses.Add(newLog);
        }

        await dbContext.RequestResponse.AddRangeAsync(newRequestResponses);
        await dbContext.SaveChangesAsync();
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error while saving changes: {ex.Message}");

        if (ex.InnerException != null)
        {
            Console.WriteLine($"Inner exception: {ex.InnerException.Message}");
        }
    }
}
