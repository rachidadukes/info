public async Task SaveNewTagNamesAsync(List<TagNameListModel> tags)
{
    if (tags == null || tags.Count == 0)
        return;

    using var openDb = new OpenSQLiteDatabase();
    using var dbContext = openDb.OpenDatabase();

    var newTagNames = tags
        .Where(t => !string.IsNullOrWhiteSpace(t.TagName))
        .Select(t => t.TagName.Trim())
        .Distinct()
        .ToList();

    var existingTagNames = await dbContext.TagNameList
        .Where(t => newTagNames.Contains(t.TagName))
        .Select(t => t.TagName)
        .ToListAsync();

    var tagsToAdd = newTagNames
        .Except(existingTagNames)
        .Select(tagName => new TagNameListModel
        {
            TagName = tagName
        })
        .ToList();

    if (tagsToAdd.Count > 0)
    {
        await dbContext.TagNameList.AddRangeAsync(tagsToAdd);
        await dbContext.SaveChangesAsync();
    }
}



