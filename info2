using Domain.DTOs;

namespace Domain.Mappers
{
    public static class VerifyAcctEntityMapper
    {
        public static AccountVerificationResponseDTO MapVerifyAcct(
            this VerifyAccountRs response)
        {
            var dto = new AccountVerificationResponseDTO();

            if (response?.RespDisplayData == null)
                return dto;

            foreach (var item in response.RespDisplayData)
            {
                if (string.IsNullOrWhiteSpace(item))
                    continue;

                if (item.StartsWith("Member Name:", StringComparison.OrdinalIgnoreCase))
                {
                    dto.MemberName = item.Replace("Member Name:", "").Trim();
                }
                else if (item.StartsWith("Account Status:", StringComparison.OrdinalIgnoreCase))
                {
                    dto.AccountStatus = item.Replace("Account Status:", "").Trim();
                }
                else if (!item.StartsWith("Member Alerts:", StringComparison.OrdinalIgnoreCase))
                {
                    dto.Alerts.Add(item.Trim());
                }
            }

            return dto;
        }
    }
}
