CREATE TABLE RequestTypeTranCodes
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    RequestType TEXT,
    TranCode TEXT
);

INSERT INTO RequestTypeTranCodes (RequestType, TranCode)
SELECT DISTINCT
       TRIM(RequestType),
       TRIM(TranCode)
FROM LogDetails
WHERE RequestType IS NOT NULL
  AND TranCode IS NOT NULL
  AND TRIM(RequestType) <> ''
  AND TRIM(TranCode) <> '';
