
<Window x:Class="WpfApiTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Api Tester"
        Width="1180"
        Height="960"
        MinWidth="1000"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="18"
                Background="#17324D"
                CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="API Tester" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#D6E5F5"
                           Text="Load saved XML requests from SQLite, send them to the API, and inspect the formatted XML response." />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    FontSize="14">
            <TabItem Header="Requests">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="110" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>                          
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        

                        <Border Grid.Column="2"
                                Padding="8,6"
                                Background="#F4FAF6"
                                BorderBrush="#B8DEC2"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Margin="0,0,14,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#215732"
                                           Content="API URL" />

                                <Label x:Name="ApiUrlLabel"
                                         Grid.Column="1"
                                         Padding="12"
                                         FontSize="14" FontWeight="SemiBold"
                                         Background="White"
                                         BorderBrush="#9FC5AA"
                                         HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ListBox x:Name="RequestsListBox"
                             Grid.Row="1"
                             Margin="0,0,0,18"
                             DisplayMemberPath="DisplayText"
                             FontFamily="Consolas"
                             FontSize="14"
                             SelectionChanged="RequestsListBox_OnSelectionChanged" />

                    <TextBlock Grid.Row="2"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#183B56"
                               Text="Selected Request" />

                    <TextBox x:Name="SelectedRequestTextBox"
                             Grid.Row="3"
                             Margin="0,12,0,16"
                             Padding="12"
                             FontFamily="Consolas"
                             FontSize="14"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />

                    <Button x:Name="SendButton"
                             Grid.Row="4"
                             Width="220"
                             Height="44"
                             Margin="0,8,0,0"
                             HorizontalAlignment="Center"
                             Padding="18,10"
                            Background="#2F80ED"
                            BorderBrush="#2F80ED"
                            Click="SendButton_OnClick"
                            Content="Call API"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold" />
                </Grid>
            </TabItem>

            <TabItem x:Name="ResponseTab" Header="Response">
                <Grid Margin="14">
                    <TextBox x:Name="ResponseTextBox"
                             Padding="12"
                             FontFamily="Consolas"
                             FontSize="14"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="12,10"
                Background="White"
                BorderBrush="#D6E0EA"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#35546E"
                       Text="Idle" />
        </Border>
    </Grid>
</Window>
