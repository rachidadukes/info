  if (verified.HasValue)
    {
        q = q.Where(r => r.Verified == verified.Value);
    }

    return await q
        .GroupBy(r => new
        {
            r.AccountNumber,
            r.AccountType,
            r.Environment,
            r.Verified
        })
        .Select(r => new VerifiedAccountsModel
        {
            AccountNumber = r.Key.AccountNumber,
            AccountType = r.Key.AccountType,
            Environment = r.Key.Environment,
            Verified = r.Key.Verified,
            AccountStatus = r.FirstOrDefault()!.AccountStatus,
            MemberName = r.FirstOrDefault()!.MemberName,
            AlertsCount = r.FirstOrDefault()!.AlertsCount
        })
        .OrderBy(r => r.AccountNumber)
        .Take(take)
        .ToListAsync(ct);
}
