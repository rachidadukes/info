    allAccessAcctNums = await dbContext.AccessAcctNumbers
        .Where(e => e.Environment != null &&
                    e.Environment.Contains(Environment))
        .Select(s => new AccessAcctNumbersModel
        {
            Id = s.Id,
            Environment = s.Environment,
            AccessNumber = s.AccessNumber,
            AccountNumber = s.AccountNumber,
            AccountType = s.AccountType,
            LogId = s.LogId,

            HasAccountInfoRecord = dbContext.AccountInfo.Any(a =>
                a.AccountNumber == s.AccountNumber &&
