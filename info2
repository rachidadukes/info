public sealed class RequestsDbContext : DbContext
{
    public DbSet<ResponseEntity> Responses => Set<ResponseEntity>();

    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)
    {
        if (!optionsBuilder.IsConfigured)
        {
            optionsBuilder.UseSqlite($"Data Source={AppDb.DatabasePath}");
        }
    }

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        modelBuilder.Entity<ResponseEntity>(entity =>
        {
            entity.ToTable("Responses");
            entity.HasKey(x => x.Id);

            entity.Property(x => x.Id).HasColumnName("ID");
            entity.Property(x => x.Description);
            entity.Property(x => x.Request);
            entity.Property(x => x.Response);
            entity.Property(x => x.DateStamp);
            entity.Property(x => x.StatusCode);
            entity.Property(x => x.StatusPhrase);
            entity.Property(x => x.Environment);
            entity.Property(x => x.Type);
        });
    }
}

=============================

protected override void OnStartup(StartupEventArgs e)
{
    base.OnStartup(e);

    AppDb.Initialize();
}
=============================

public static class AppDb
{
    public static string DatabasePath { get; private set; } = string.Empty;

    public static void Initialize()
    {
        DatabasePath = Path.GetFullPath(
            Path.Combine(AppContext.BaseDirectory, "Requests.sqlite"));
    }
}
