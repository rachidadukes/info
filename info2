public static CD_DepositResponseDTO MapCD_Deposit(
    this CD_DepositRs response)
{
    var dto = new CD_DepositResponseDTO();

    var info = response?.FinancialPostingServiceInfo;

    if (info == null)
        return dto;

    // ETS Status
    dto.ETSTranStatus = info.ETSTranStatus;

    // Messages
    dto.Messages = info.RespDisplayData?.InfoMessage?.ToList()
                   ?? new List<string>();

    // Correction Data
    var correction = info.Corrections?.CorrectionInd;

    if (correction != null)
    {
        dto.TranCode = correction.TranCode;
        dto.FileId = correction.FileId;
        dto.UId = correction.UId;
    }

    return dto;
}


==================

public class CD_DepositResponseDTO
{
    public string? ETSTranStatus { get; set; }

    public List<string> Messages { get; set; } = new();

    public int TranCode { get; set; }

    public int FileId { get; set; }

    public string? UId { get; set; }
}




