<Grid RowDefinitions="Auto,*,Auto">

    <!-- Existing comparison grid -->
    <Grid Grid.Row="1" ColumnDefinitions="*,10,*">
        <RichTextBox x:Name="LeftRequestTextBox" Grid.Column="0" />
        <RichTextBox x:Name="RightRequestTextBox" Grid.Column="2" />
    </Grid>

    <!-- NEW: Missing tags panel -->
    <Grid Grid.Row="2" Margin="0,10,0,0" ColumnDefinitions="*,10,*">

        <!-- Missing from LEFT -->
        <GroupBox Header="Missing From LEFT" Grid.Column="0">
            <TextBox x:Name="MissingFromLeftTextBox"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <!-- Missing from RIGHT -->
        <GroupBox Header="Missing From RIGHT" Grid.Column="2">
            <TextBox x:Name="MissingFromRightTextBox"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

    </Grid>
</Grid>
