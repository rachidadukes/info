using Spectre.Console;

public static void DisplayLegalHold(IEnumerable<EJDetail> first20Records)
{
    try
    {
        var records = first20Records.ToList();

        if (records.Count == 0)
        {
            AnsiConsole.MarkupLine(
                "[yellow]No Legal Hold records were found.[/]");

            return;
        }

        var grid = new Grid();

        // Property-name column
        grid.AddColumn(
            new GridColumn()
                .NoWrap()
                .PadRight(4));

        // Value column
        grid.AddColumn(new GridColumn());

        for (var index = 0; index < records.Count; index++)
        {
            var detail = records[index];

            grid.AddRow(
                "[bold deepskyblue1]Record ID[/]",
                $"[bold yellow]{detail.RecordID:N0}[/]");

            grid.AddRow(
                "[bold deepskyblue1]Field Sequence[/]",
                $"[bold yellow]{detail.FieldSequence:N0}[/]");

            grid.AddRow(
                "[bold deepskyblue1]Field Name[/]",
                $"[white]{Markup.Escape(detail.FieldName ?? "N/A")}[/]");

            grid.AddRow(
                "[bold deepskyblue1]Field Type[/]",
                $"[green]{Markup.Escape(detail.FieldType ?? "N/A")}[/]");

            grid.AddRow(
                "[bold deepskyblue1]Field Value[/]",
                $"[bold gold1]{Markup.Escape(detail.FieldValue ?? "N/A")}[/]");

            // Add a separator between records, but not after the final record.
            if (index < records.Count - 1)
            {
                grid.AddEmptyRow();

                grid.AddRow(
                    "[grey]----------------------[/]",
                    "[grey]----------------------------------------[/]");

                grid.AddEmptyRow();
            }
        }

        var panel = new Panel(grid)
        {
            Header = new PanelHeader(
                "[bold yellow] Legal Hold [/]",
                Justify.Center),

            Border = BoxBorder.Double,
            BorderStyle = new Style(Color.DodgerBlue1),
            Padding = new Padding(
                left: 2,
                top: 1,
                right: 2,
                bottom: 1)
        };

        AnsiConsole.Write(panel);
    }
    catch (Exception ex)
    {
        AnsiConsole.WriteException(
            ex,
            ExceptionFormats.ShortenPaths |
            ExceptionFormats.ShortenTypes |
            ExceptionFormats.ShowLinks);
    }
}
