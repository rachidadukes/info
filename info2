using System.Windows;
using System.Windows.Controls;
using System.Windows.Documents;
using System.Windows.Media;

namespace YourProject.Helpers
{
    public static class RichTextBoxHighlighter
    {
        public static void HighlightTextBetweenTags(
            RichTextBox richTextBox,
            string startTag,
            string endTag,
            Brush brush,
            bool bold = false)
        {
            if (richTextBox == null)
                return;

            TextRange fullRange = new TextRange(
                richTextBox.Document.ContentStart,
                richTextBox.Document.ContentEnd);

            string fullText = fullRange.Text;

            int currentIndex = 0;

            while (true)
            {
                int startTagIndex = fullText.IndexOf(
                    startTag,
                    currentIndex);

                if (startTagIndex < 0)
                    break;

                int contentStartIndex =
                    startTagIndex + startTag.Length;

                int endTagIndex = fullText.IndexOf(
                    endTag,
                    contentStartIndex);

                if (endTagIndex < 0)
                    break;

                int contentLength =
                    endTagIndex - contentStartIndex;

                TextPointer startPointer =
                    GetTextPointerAtOffset(
                        richTextBox.Document.ContentStart,
                        contentStartIndex);

                TextPointer endPointer =
                    GetTextPointerAtOffset(
                        richTextBox.Document.ContentStart,
                        contentStartIndex + contentLength);

                if (startPointer != null && endPointer != null)
                {
                    TextRange textRange =
                        new TextRange(startPointer, endPointer);

                    textRange.ApplyPropertyValue(
                        TextElement.ForegroundProperty,
                        brush);

                    if (bold)
                    {
                        textRange.ApplyPropertyValue(
                            TextElement.FontWeightProperty,
                            FontWeights.Bold);
                    }
                }

                currentIndex = endTagIndex + endTag.Length;
            }
        }

        private static TextPointer GetTextPointerAtOffset(
            TextPointer start,
            int offset)
        {
            TextPointer current = start;
            int count = 0;

            while (current != null)
            {
                if (current.GetPointerContext(
                    LogicalDirection.Forward)
                    == TextPointerContext.Text)
                {
                    string textRun =
                        current.GetTextInRun(
                            LogicalDirection.Forward);

                    if (count + textRun.Length >= offset)
                    {
                        return current.GetPositionAtOffset(
                            offset - count);
                    }

                    count += textRun.Length;
                }

                TextPointer next =
                    current.GetNextContextPosition(
                        LogicalDirection.Forward);

                if (next == null)
                    break;

                current = next;
            }

            return current;
        }
    }
}
