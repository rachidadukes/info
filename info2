public async Task<PagedResult<VerifiedAccountsModel>> GetVerifiedAccountNumbersAsync(
    string? environment = null,
    bool? verified = null,
    int skip = 0,
    int take = 50,
    CancellationToken ct = default) =>
    await http.GetFromJsonAsync<PagedResult<VerifiedAccountsModel>>(
        BuildVerifiedAcctdUrl(VerifiedAccountsPath, environment, verified, skip, take), ct)
    ?? new PagedResult<VerifiedAccountsModel>();
