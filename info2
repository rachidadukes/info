        private async Task<ResultWrapper<MemberSearchRespDTO>> GetAllResponse(string selectedApiType, String SoapXMLRequest, string endpoint)
        {
            string cleanXMLResponse;
            StringReader? stringReader = null;
            MyApp.Domain.SearchMemberRs? rootResponse = null;
            MemberSearchRespDTO memberSearchSimplified;
            try
            {

                var responseBody = await GetResponseAsync(SoapXMLRequest, endpoint, selectedApiType);

                // Strip xmlns namespaces so XmlSerializer can match elements by local name only.
                cleanXMLResponse = XmlNamespaceHelper.StripNamespaces(responseBody);

                XmlSerializer serializer = new XmlSerializer(typeof(MyApp.Domain.SearchMemberRs));
                stringReader = new StringReader(cleanXMLResponse);

                rootResponse = (MyApp.Domain.SearchMemberRs)serializer.Deserialize(stringReader)!;
              


                if (rootResponse is not null)
                {
                    memberSearchSimplified = MemberEntityMapper.MapSearchMember(rootResponse);
                    return new ResultWrapper<MemberSearchRespDTO>
                    {
                        IsSuccess = true,
                        Data = memberSearchSimplified ?? new MemberSearchRespDTO()
                    };
                }
                else
                {
                    return new ResultWrapper<MemberSearchRespDTO>
                    {
                        IsSuccess = false,
                        ErrorMessage = "Failed to deserialize XML response."
                    };
                }

            }
            catch (Exception ex)
            {
                Console.WriteLine("Error reading XML Response: " + ex.Message);
                return new ResultWrapper<MemberSearchRespDTO>();
            }
            finally
            {
                stringReader?.Dispose();
            }

        }
        public async Task<string> GetResponseAsync(string requestXml, string endpoint, string selectedApiType)
        {
            try
            {
                string responseXml;

                if (selectedApiType == TypeValues.Endpoint.LegacyEndpoint)
                    responseXml = await GetLegacyResponseAsync(requestXml, endpoint);
                else
                    responseXml = await GetNewResponse(endpoint, requestXml);

                return responseXml;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error sending SOAP request: " + ex.Message);
                return string.Empty;
            }
        }


        private async Task<string> GetLegacyResponseAsync(string requestXml, string endpoint)
        {
            string errorXml = string.Empty;
            string xmlString = string.Empty;
            string updatedXml = string.Empty;

            try
            {
                updatedXml = XmlNamespaceHelper.AddMissingNamespaces(requestXml);

                var binding = new BasicHttpBinding
                {
                    MaxBufferSize          = int.MaxValue,
                    MaxReceivedMessageSize = int.MaxValue,
                    ReaderQuotas           = System.Xml.XmlDictionaryReaderQuotas.Max,
                    AllowCookies           = true,
                    Security               = { Mode = BasicHttpSecurityMode.Transport }
                };
                var address = new EndpointAddress(endpoint);
                MemberTransactionWsClient _client = new MemberTransactionWsClient(binding, address);

                SearchMemberRq inqRq = XmlConverter.Deserialize<SearchMemberRq>(updatedXml);

                searchForMemberResponseMessage responseMessage =
                    await _client.searchForMemberAsync(inqRq);

                SearchMemberRs result = responseMessage.SearchMemberRs;

                string xml = ObjectToXmlSerializer.ToXmlString(result);
                xml = ObjectToXmlSerializer.ToXmlString(result.MemberRec);

                xmlString = ObjectToXmlSerializer.ToXmlString(result);

                return xmlString?.ToString() ?? string.Empty;
            }

            catch (InvalidOperationException ex)
                 when (ex.InnerException is System.Xml.XmlException xmlEx)
            {
                errorXml = "===== XML DESERIALIZATION ERROR =====";
                errorXml = $"Message  : {xmlEx.Message}";
                errorXml = $"Line     : {xmlEx.LineNumber}";
                errorXml = $"Position : {xmlEx.LinePosition}";
                return errorXml;
            }
            catch (FaultException faultEx)
            {
                errorXml = "SOAP Fault:";
                errorXml = errorXml + "Message: " + faultEx.Message;
                errorXml = errorXml + "Code: " + faultEx.Code;
                errorXml = errorXml + "Reason: " + faultEx.Reason;
                return errorXml;
            }
            catch (CommunicationException ce)
            {
                errorXml = "Communication error:";
                errorXml = errorXml + "Message: " + ce.Message;
                errorXml = errorXml + "Details: " + ce.ToString();
                return errorXml;
            }
            catch (Exception ex)
            {
                errorXml = "===== UNEXPECTED ERROR =====" + ex;
                Console.WriteLine(errorXml);
                return errorXml;
            }
        }
         
        private async Task<string> GetNewResponse(string url, string sendMessage)
        {
            string mainResponse;
            string errorXml = string.Empty;
            HttpClient httpClient = new HttpClient();

            try
            {
                var request = new HttpRequestMessage(HttpMethod.Post, url);
                var content = new StringContent(sendMessage ?? "", null, "application/xml");

                request.Content = new StringContent(
                    sendMessage ?? "",
                    Encoding.UTF8,
                    "application/xml"
                );

                var response = await httpClient.SendAsync(request);
                response.EnsureSuccessStatusCode();
                var responseXMLContent = await response.Content.ReadAsStringAsync();
                mainResponse = responseXMLContent;
                return mainResponse;
            }
            catch (InvalidOperationException ex) when (ex.InnerException is System.Xml.XmlException xmlEx)
            {
                errorXml = "===== XML DESERIALIZATION ERROR =====";
                errorXml = $"Message  : {xmlEx.Message}";
                errorXml = $"Line     : {xmlEx.LineNumber}";
                errorXml = $"Position : {xmlEx.LinePosition}";
                Console.WriteLine(errorXml);
                return errorXml;
            }
            catch (CommunicationException ce)
            {
                errorXml = "===== COMMUNICATION ERROR =====" + ce.Message;
                Console.WriteLine(errorXml);
                return errorXml;
            }
        }
