var q = db.VerifiedAccounts.AsNoTracking()
    .Where(r => r.AccountNumber != null);

if (!string.IsNullOrWhiteSpace(startsWith))
{
    q = q.Where(r => r.AccountNumber!.StartsWith(startsWith));
}

if (!string.IsNullOrWhiteSpace(environment))
{
    q = q.Where(r => r.Environment == environment);
}

if (verified.HasValue)
{
    q = q.Where(r => r.Verified == verified.Value);
}

var result = await q
    .GroupBy(r => new
    {
        r.AccountNumber,
        r.AccountType,
        r.Environment,
        r.Verified
    })
    .Select(g => new VerifiedAccountsModel
    {
        AccountNumber = g.Key.AccountNumber,
        AccountType = g.Key.AccountType,
        Environment = g.Key.Environment,
        Verified = g.Key.Verified,
        AccountStatus = g.FirstOrDefault()!.AccountStatus,
        MemberName = g.FirstOrDefault()!.MemberName,
        AlertsCount = g.FirstOrDefault()!.AlertsCount
    })
    .OrderBy(r => r.AccountNumber)
    .Take(take)
    .ToListAsync(ct);
