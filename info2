<Window x:Class="ApiTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Tester"
        Width="1100"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#111827"
                CornerRadius="10"
                Padding="20">
            <StackPanel>
                <TextBlock Text="API Tester"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>
                <TextBlock Text="Load canned XML requests from SQLite, send them to the API, and inspect the formatted XML response."
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1"
                Margin="0,40,0,0"
                BorderBrush="#CFCFCF"
                BorderThickness="1"
                Background="#FAFAFA">

            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Transaction Type -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <TextBlock Text="Transaction Type:"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <ComboBox Width="170"
                              Height="25"/>
                </StackPanel>

                <!-- API Info Table -->
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Margin="0,0,0,15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ApiType" Width="*"/>
                        <DataGridTextColumn Header="Endpoint" Width="2*"/>
                        <DataGridTextColumn Header="Environment" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Request Table -->
                <DataGrid Grid.Row="2"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Margin="0,0,0,20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="120"/>
                        <DataGridTextColumn Header="Description" Width="3*"/>
                        <DataGridTextColumn Header="Type" Width="*"/>
                        <DataGridTextColumn Header="MemberSearchType" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Center Message -->
                <Grid Grid.Row="3">
                    <Border Width="420"
                            Height="145"
                            Background="#D90404"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="Give me the xaml code to&#x0a;generate this wpf window"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button Content="Member Search"
                    Width="190"
                    Height="42"
                    Margin="8"
                    Background="#2F75B5"
                    Foreground="White"
                    FontWeight="SemiBold"/>

            <Button Content="Member Profile"
                    Width="190"
                    Height="42"
                    Margin="8"
                    Background="#2F75B5"
                    Foreground="White"
                    FontWeight="SemiBold"/>

            <Button Content="CD Deposit"
                    Width="190"
                    Height="42"
                    Margin="8"
                    Background="#2F75B5"
                    Foreground="White"
                    FontWeight="SemiBold"/>

            <Button Content="IRA CD Deposit"
                    Width="190"
                    Height="42"
                    Margin="8"
                    Background="#2F75B5"
                    Foreground="White"
                    FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Bottom Text Area -->
        <TextBox Grid.Row="3"
                 Height="25"
                 VerticalAlignment="Bottom"
                 BorderBrush="#D0D0D0"
                 Background="#EFEFEF"/>
    </Grid>
</Window>
