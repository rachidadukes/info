if (userSelection.TransactionType == TypeValues.TransactionType.MemberSearch)
{
    AnsiConsole.MarkupLine(
        $"Transaction Type: [yellow]{userSelection.TransactionType}[/]");

    selectionService.SelectMemberSearchType(userSelection);

    if (userSelection.MemberSearchType ==
        TypeValues.MemberSearchType.MemberSearchAccessNumber)
    {
        await HandleMemberSearchByAccessNumber(userSelection);
    }
}

async Task HandleMemberSearchByAccessNumber(UserSelection userSelection)
{
    AnsiConsole.MarkupLine(
        $"Member Search Type: [yellow]{userSelection.MemberSearchType}[/]");

    string hostResponse = null;

    var apiObject = new MemberSearchByAccessNumber();

    userSelection.AccessNumber =
        await apiObject.SelectAccessNumber(userSelection.Environment);

    hostResponse = await apiObject.CallAPI(userSelection);
}
