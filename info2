
Public Function GetMemberSearchRoutingMode(xml As String) As String

    Dim section As NameValueCollection =
        TryCast(ConfigurationManager.GetSection("hostRouting"), NameValueCollection)

    ' Read routing mode
    Dim routingMode As String =
        If(section?(MessageConverterValues.ConfigKeys.RMRoutingFlag), String.Empty).
        Trim().
        ToUpperInvariant()

    ' Read transaction code list
    Dim codesCsv As String =
        If(section?(MessageConverterValues.ConfigKeys.RMHostTranCodes), String.Empty)

    ' Parse XML
    Dim doc As XDocument = XDocument.Parse(xml)

    Dim tranCode As String =
        doc.Descendants("TranCode").
            FirstOrDefault()?.
            Value?.
            Trim()

    ' Build transaction code lookup
    Dim codes As New HashSet(Of String)(
        codesCsv.Split(New Char() {","c}, StringSplitOptions.RemoveEmptyEntries).
        Select(Function(s) s.Trim()),
        StringComparer.OrdinalIgnoreCase)

    '==========================
    ' Business Rules
    '==========================

    Dim isLegacy As Boolean =
        routingMode = MessageConverterValues.HostRoutes.LegacyEndpoint

    Dim isNew As Boolean =
        routingMode = MessageConverterValues.HostRoutes.NewEndpoint

    Dim isBoth As Boolean =
        routingMode = MessageConverterValues.HostRoutes.BothEndpoints

    Dim hasRoutingMode As Boolean =
        Not String.IsNullOrWhiteSpace(routingMode)

    Dim hasTranCodeList As Boolean =
        Not String.IsNullOrWhiteSpace(codesCsv)

    Dim hasValidTranCode As Boolean =
        Not String.IsNullOrWhiteSpace(tranCode) AndAlso
        codes.Contains(tranCode)

    Dim hasValidWorkStation As Boolean =
        IsValidWorkStation(section)

    Dim isSupportedRoutingMode As Boolean =
        isLegacy OrElse isNew OrElse isBoth

    Dim useLegacy As Boolean =
        Not hasRoutingMode OrElse
        Not isSupportedRoutingMode OrElse
        isLegacy OrElse
        Not hasTranCodeList OrElse
        Not hasValidTranCode OrElse
        Not hasValidWorkStation

    '==========================
    ' Routing Decision
    '==========================

    If useLegacy Then
        Return MessageConverterValues.HostRoutes.LegacyEndpoint
    End If

    If isBoth Then
        Return MessageConverterValues.HostRoutes.BothEndpoints
    End If

    Return MessageConverterValues.HostRoutes.NewEndpoint

End Function
