var selectionService = new UserSelectionService();

var userSelection = selectionService.GetUserSelections();

var dataService = new DataService();

var accessNumbers =
    await dataService.GetAccessNumbersAsync(userSelection.Environment);

selectionService.SelectAccessNumber(
    userSelection,
    accessNumbers);

AnsiConsole.MarkupLine(
    $"Environment: [yellow]{userSelection.Environment}[/]");

AnsiConsole.MarkupLine(
    $"API Type: [yellow]{userSelection.APIType}[/]");

AnsiConsole.MarkupLine(
    $"Access Number: [yellow]{userSelection.AccessNumber}[/]");
