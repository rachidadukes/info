<Window x:Class="YourNamespace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextBoxes and Tabs"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- First TextBox -->
        <TextBox Grid.Row="0"
                 Height="35"
                 Margin="0,0,0,10"
                 FontSize="16"
                 VerticalContentAlignment="Center"
                 Text="First TextBox" />

        <!-- Second TextBox -->
        <TextBox Grid.Row="1"
                 Height="35"
                 Margin="0,0,0,15"
                 FontSize="16"
                 VerticalContentAlignment="Center"
                 Text="Second TextBox" />

        <!-- Tabs -->
        <TabControl Grid.Row="2">

            <!-- Tab 1 -->
            <TabItem Header="Tab 1">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0"
                              Margin="0,0,0,10">
                        <ListViewItem Content="Tab 1 Item 1"/>
                        <ListViewItem Content="Tab 1 Item 2"/>
                        <ListViewItem Content="Tab 1 Item 3"/>
                    </ListView>

                    <Button Grid.Row="1"
                            Width="120"
                            Height="35"
                            HorizontalAlignment="Right"
                            Content="Button 1"/>
                </Grid>
            </TabItem>

            <!-- Tab 2 -->
            <TabItem Header="Tab 2">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0"
                              Margin="0,0,0,10">
                        <ListViewItem Content="Tab 2 Item 1"/>
                        <ListViewItem Content="Tab 2 Item 2"/>
                        <ListViewItem Content="Tab 2 Item 3"/>
                    </ListView>

                    <Button Grid.Row="1"
                            Width="120"
                            Height="35"
                            HorizontalAlignment="Right"
                            Content="Button 2"/>
                </Grid>
            </TabItem>

            <!-- Tab 3 -->
            <TabItem Header="Tab 3">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0"
                              Margin="0,0,0,10">
                        <ListViewItem Content="Tab 3 Item 1"/>
                        <ListViewItem Content="Tab 3 Item 2"/>
                        <ListViewItem Content="Tab 3 Item 3"/>
                    </ListView>

                    <Button Grid.Row="1"
                            Width="120"
                            Height="35"
                            HorizontalAlignment="Right"
                            Content="Button 3"/>
                </Grid>
            </TabItem>

            <!-- Tab 4 -->
            <TabItem Header="Tab 4">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0"
                              Margin="0,0,0,10">
                        <ListViewItem Content="Tab 4 Item 1"/>
                        <ListViewItem Content="Tab 4 Item 2"/>
                        <ListViewItem Content="Tab 4 Item 3"/>
                    </ListView>

                    <Button Grid.Row="1"
                            Width="120"
                            Height="35"
                            HorizontalAlignment="Right"
                            Content="Button 4"/>
                </Grid>
            </TabItem>

            <!-- Tab 5 -->
            <TabItem Header="Tab 5">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0"
                              Margin="0,0,0,10">
                        <ListViewItem Content="Tab 5 Item 1"/>
                        <ListViewItem Content="Tab 5 Item 2"/>
                        <ListViewItem Content="Tab 5 Item 3"/>
                    </ListView>

                    <Button Grid.Row="1"
                            Width="120"
                            Height="35"
                            HorizontalAlignment="Right"
                            Content="Button 5"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>

</Window>
