public async Task SaveAsync(AccountInfoModel accountInfo)
{
    string sql = @"
        INSERT INTO AccountInfo
        (
            AccountNumber,
            AccountStatus,
            AvailableBalance,
            AccountType,
            ProductCode,
            ProductDescription,
            Environment,
            ErrorMessage
        )
        VALUES
        (
            @AccountNumber,
            @AccountStatus,
            @AvailableBalance,
            @AccountType,
            @ProductCode,
            @ProductDescription,
            @Environment,
            @ErrorMessage
        )";

    await DatabaseHelper.ExecuteNonQueryAsync(sql, accountInfo);
} 

