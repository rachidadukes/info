public async Task CallVerifyAccountService(
    string selectedItemAccountNumber,
    string selectedItemAccountType,
    string selectedItemEnvironment)
{
    try
    {
        var acctObject = new VerifyAcctResponse();

        string xmlStringResponse =
            await acctObject.GetVerifyAccountXMLResponseAsync(
                selectedItemAccountNumber,
                selectedItemAccountType,
                selectedItemEnvironment);

        var resultWrapper =
            await acctObject.GetAccountVerifyAsync(xmlStringResponse);

        if (resultWrapper?.Data == null)
        {
            MessageBox.Show(
                "No account verification found.",
                "Information",
                MessageBoxButton.OK,
                MessageBoxImage.Information);

            return;
        }

        AccountVerificationResponseDTO verifyAcctResponse = resultWrapper.Data;

        string message =
            $"Member Name: {verifyAcctResponse.MemberName}{Environment.NewLine}" +
            $"Account Status: {verifyAcctResponse.AccountsStatus}{Environment.NewLine}" +
            $"Member Alerts:{Environment.NewLine}";

        if (verifyAcctResponse.Alerts != null &&
            verifyAcctResponse.Alerts.Any())
        {
            foreach (var alert in verifyAcctResponse.Alerts)
            {
                message += alert + Environment.NewLine;
            }
        }
        else
        {
            message += "No alerts found.";
        }

        MessageBox.Show(
            message,
            "Host Response",
            MessageBoxButton.OK,
            MessageBoxImage.Information);
    }
    catch (Exception ex)
    {
        MessageBox.Show(
            ex.Message,
            "Error",
            MessageBoxButton.OK,
            MessageBoxImage.Error);
    }
}
