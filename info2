private void LogsListView_SelectionChanged(object sender, SelectionChangedEventArgs e)
{
    try
    {
        if (LogsListView.SelectedItem is not RequestResponseModel selectedLog)
            return;

        SetRichTextBoxText(
            txtRequest,
            string.IsNullOrWhiteSpace(selectedLog.Request)
                ? "No Request Found"
                : selectedLog.Request);

        SetRichTextBoxText(
            txtResponse,
            string.IsNullOrWhiteSpace(selectedLog.Response)
                ? "No Response Found"
                : selectedLog.Response);
    }
    catch (Exception ex)
    {
        MessageBox.Show(ex.Message);
    }
}
