
using Entities;
using Spectre.Console;

namespace Services;

public class UserSelectionService
{
    public UserSelectionModel GetUserSelections()
    {
        var model = new UserSelectionModel();

        // API Type
        var apiTypes = new List<string> { "Legacy", "New" };

        model.APIType = AnsiConsole.Prompt(
            new SelectionPrompt<string>()
                .Title("Select API Type")
                .PageSize(10)
                .AddChoices(apiTypes));

        // Environment
        var environments = new List<string> { "UNIT", "INTG" };

        model.Environment = AnsiConsole.Prompt(
            new SelectionPrompt<string>()
                .Title("Select Environment")
                .PageSize(10)
                .AddChoices(environments));

        return model;
    }

    public void SelectAccessNumber(
        UserSelectionModel model,
        List<AccessNumbersModel> accessNumbers)
    {
        var selected = AnsiConsole.Prompt(
            new SelectionPrompt<AccessNumbersModel>()
                .Title("Access Number Selection")
                .PageSize(10)
                .UseConverter(x => x.AccessNumber ?? string.Empty)
                .AddChoices(accessNumbers));

        model.AccessNumber = selected.AccessNumber;
    }
}
