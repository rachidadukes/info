private void HighlightSelectedTagName(RequestResponseModel requestResponse)
{
    if (!string.IsNullOrWhiteSpace(requestResponse.Request))
    {
        XmlViewHelper.SetRichTextBoxTextWithHighlight(
            txtRequest,
            requestResponse.Request,
            selectedTagName);
    }

    if (!string.IsNullOrWhiteSpace(requestResponse.Response))
    {
        XmlViewHelper.SetRichTextBoxTextWithHighlight(
            txtResponse,
            requestResponse.Response,
            selectedTagName);
    }
}
