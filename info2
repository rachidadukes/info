    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Requests list (distinct Description / Type / Environment from Responses table) -->
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#35546E"
                   Text="Requests" />

        <ListView x:Name="HistoryListBox"
                  Grid.Row="1"
                  BorderThickness="1"
                  BorderBrush="#D6E0EA"
                  FontFamily="Consolas"
                  FontSize="13"
                  Margin="0,0,0,12"
                  SelectionMode="Single"
                  SelectionChanged="HistoryListBox_OnSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Description"
                                    Width="420"
                                    DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="Type"
                                    Width="180"
                                    DisplayMemberBinding="{Binding Type}" />
                    <GridViewColumn Header="Environment"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Environment}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Request label + selected entry info -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,6">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#183B56"
                       Text="Request" />
            <TextBlock x:Name="TimestampLabel"
                       Margin="14,0,0,0"
                       FontSize="13"
                       Foreground="#35546E"
                       Text="— select a response above" />
            <TextBlock x:Name="StatusLabel"
                       Margin="14,0,0,0"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </StackPanel>

        <TextBox x:Name="RequestDetailTextBox"
                 Grid.Row="3"
                 Margin="0,0,0,12"
                 Padding="10"
                 FontFamily="Consolas"
                 FontSize="13"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" />

        <!-- Response section -->
        <TextBlock Grid.Row="4"
                   Margin="0,0,0,6"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#183B56"
                   Text="Response" />

        <TextBox x:Name="ResponseDetailTextBox"
                 Grid.Row="5"
                 Padding="10"
                 FontFamily="Consolas"
                 FontSize="13"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
