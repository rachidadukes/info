public async Task SaveAsync(AccountInfoModel accountInfo)
{
    OpenSQLiteDatabase openDb = new OpenSQLiteDatabase();
    var dbContext = openDb.OpenDatabase();

    if (dbContext == null)
        return;

    bool alreadyExists = await dbContext.AccountInfo.AnyAsync(x =>
        x.AccountNumber == accountInfo.AccountNumber &&
        x.AccountType == accountInfo.AccountType &&
        x.AvailableBalance == accountInfo.AvailableBalance);

    if (!alreadyExists)
    {
        dbContext.AccountInfo.Add(accountInfo);
        await dbContext.SaveChangesAsync();
    }
}
