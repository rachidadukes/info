  <StackPanel x:Name="MemberSearchOptionsPanel"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Visibility="Collapsed">

====================================

private void TransactionTypeComboBox_SelectionChanged(
    object sender,
    SelectionChangedEventArgs e)
{
    if (TransactionTypeComboBox.SelectedItem == null)
    {
        MemberSearchOptionsPanel.Visibility = Visibility.Collapsed;
        return;
    }

    string selectedTransaction =
        TransactionTypeComboBox.SelectedItem.ToString();

    bool isMemberSearch =
        selectedTransaction.Contains("MemberSearch");

    MemberSearchOptionsPanel.Visibility =
        isMemberSearch
            ? Visibility.Visible
            : Visibility.Collapsed;
}
