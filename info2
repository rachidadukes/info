private async Task<List<ResponseResult>> LoadLatestResponseAsync(RequestItem item)
{
    if (!File.Exists(_databasePath))
        return new List<ResponseResult>();

    try
    {
        await using var db = new RequestsDbContext(_databasePath);

        var results = await db.Responses
            .AsNoTracking()
            .Where(r =>
                r.Description == item.Description &&
                r.Type == item.Type &&
                r.Environment == item.Environment)
            .OrderByDescending(r => r.Id)
            .Select(r => new ResponseResult
            {
                Request = r.Request ?? string.Empty,
                Response = r.Response ?? string.Empty,
                DateStamp = r.DateStamp ?? string.Empty,
                StatusCode = r.StatusCode,
                StatusPhrase = r.StatusPhrase
            })
            .ToListAsync();

        return results;
    }
    catch (Exception ex)
    {
        MessageBox.Show(
            ex.Message,
            "Error Loading Response",
            MessageBoxButton.OK,
            MessageBoxImage.Error);

        return new List<ResponseResult>();
    }
}
