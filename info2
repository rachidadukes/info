
using System.Text.RegularExpressions;
using System.Windows.Controls;
using System.Windows.Documents;
using System.Windows.Media;

namespace YourProject.Helpers
{
    public static class RichTextBoxHighlighter
    {
        /// <summary>
        /// Highlights text located between XML tags.
        /// Example:
        /// <TranCode>H001</TranCode>
        /// will highlight H001 only.
        /// </summary>
        public static void HighlightTextBetweenTags(
            RichTextBox richTextBox,
            string startTag,
            string endTag,
            Brush foregroundBrush,
            bool isBold = false)
        {
            if (richTextBox == null)
                return;

            TextRange documentRange = new TextRange(
                richTextBox.Document.ContentStart,
                richTextBox.Document.ContentEnd);

            string text = documentRange.Text;

            string pattern =
                $@"(?<={Regex.Escape(startTag)}).*?(?={Regex.Escape(endTag)})";

            MatchCollection matches = Regex.Matches(
                text,
                pattern,
                RegexOptions.Singleline);

            foreach (Match match in matches)
            {
                TextPointer start = GetTextPositionAtOffset(
                    richTextBox.Document.ContentStart,
                    match.Index);

                TextPointer end = GetTextPositionAtOffset(
                    start,
                    match.Length);

                if (start == null || end == null)
                    continue;

                TextRange range = new TextRange(start, end);

                range.ApplyPropertyValue(
                    TextElement.ForegroundProperty,
                    foregroundBrush);

                if (isBold)
                {
                    range.ApplyPropertyValue(
                        TextElement.FontWeightProperty,
                        FontWeights.Bold);
                }
            }
        }

        private static TextPointer GetTextPositionAtOffset(
            TextPointer start,
            int characterCount)
        {
            TextPointer current = start;
            int cnt = 0;

            while (current != null)
            {
                if (current.GetPointerContext(LogicalDirection.Forward)
                    == TextPointerContext.Text)
                {
                    string textRun =
                        current.GetTextInRun(LogicalDirection.Forward);

                    if (cnt + textRun.Length >= characterCount)
                    {
                        return current.GetPositionAtOffset(
                            characterCount - cnt);
                    }

                    cnt += textRun.Length;
                }

                TextPointer next =
                    current.GetNextContextPosition(
                        LogicalDirection.Forward);

                if (next == null)
                    return current;

                current = next;
            }

            return current;
        }
    }
}







