private (string FirstName, string LastName) ExtractMemberName(string request)
{
    if (string.IsNullOrWhiteSpace(request))
        return (string.Empty, string.Empty);

    string firstName =
        ExtractTagValue(request, "FirstName");

    if (string.IsNullOrWhiteSpace(firstName))
        firstName = ExtractTagValue(request, "firstName");

    string lastName =
        ExtractTagValue(request, "LastName");

    if (string.IsNullOrWhiteSpace(lastName))
        lastName = ExtractTagValue(request, "lastName");

    return (firstName, lastName);
}

