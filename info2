
var query = q
    .GroupBy(r => new
    {
        r.Id,
        r.AccountNumber,
        r.AccountType,
        r.Environment,
        r.Verified
    })
    .Select(r => new VerifiedAccountsModel
    {
        Id = r.Key.Id,
        AccountNumber = r.Key.AccountNumber,
        AccountType = r.Key.AccountType,
        Environment = r.Key.Environment,
        Verified = r.Key.Verified,
        AccountStatus = r.FirstOrDefault()!.AccountStatus,
        MemberName = r.FirstOrDefault()!.MemberName,
        AlertsCount = r.FirstOrDefault()!.AlertsCount
    });

if (!string.IsNullOrWhiteSpace(filter))
{
    query = query.Where(filter);
}

var count = await query.CountAsync(ct);

if (!string.IsNullOrWhiteSpace(orderBy))
{
    query = query.OrderBy(orderBy);
}
else
{
    query = query.OrderBy(r => r.AccountNumber);
}

var result = await query
    .Skip(skip)
    .Take(take)
    .ToListAsync(ct);

return new PagedResult<VerifiedAccountsModel>
{
    Data = result,
    Count = count
};
