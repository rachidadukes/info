public async Task<List<LogDetailsModel>> GetMemberInfo()
{
    using var openDb = new OpenSQLiteDatabase();
    var dbContext = openDb.OpenDatabase();

    using var transaction = await dbContext.Database.BeginTransactionAsync();

    try
    {
        var requestResponses = await dbContext.RequestResponse
            .ToListAsync();

        var newLogDetails = new List<LogDetailsModel>();

        foreach (var item in requestResponses)
        {
            string request = item.Request ?? "";
            string response = item.Response ?? "";
            string fullMessage = request + response;

            var newItem = new LogDetailsModel
            {
                LogId = item.LogId,
                Environment = item.Environment,
                UserID = item.UserID,
                DateTimeStamp = item.DateTimeStamp,

                AccountNumber = ExtractTagValue(fullMessage, "AcctId"),
                AccountType = ExtractTagValue(fullMessage, "AcctType"),
                AccessNumber = ExtractTagValue(request, "CustPermId"),
                FirstName = ExtractTagValue(request, "firstName"),
                LastName = ExtractTagValue(request, "LastName"),
                TranCode = ExtractTagValue(request, "TranCode"),
                BusinessName = ExtractTagValue(request, "businessname"),
                RequestType = ExtractRequestTypeByReadingFirstTag(fullMessage),
                ResponseStatusDesc = ExtractTagValue(fullMessage, "ResponseStatusDesc")
            };

            newLogDetails.Add(newItem);
        }

        dbContext.LogDetails.RemoveRange(dbContext.LogDetails);

        await dbContext.LogDetails.AddRangeAsync(newLogDetails);

        await dbContext.SaveChangesAsync();
        await transaction.CommitAsync();

        return newLogDetails;
    }
    catch
    {
        await transaction.RollbackAsync();
        throw;
    }
}
