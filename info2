private string ResolveEndpoint(string selectedApiType, string env)
{
    try
    {
        var appEnv = ToEnv(env);

        if (selectedApiType == TypeValues.Endpoint.NewEndpoint)
        {
            var uri = _endpointResolver.ResolveNew(
                ExternalService.VerifyAccount,
                appEnv);

            return uri.AbsoluteUri;
        }

        var legacyUri = _endpointResolver.Resolve(
            ExternalService.VerifyAccount,
            appEnv);

        return legacyUri.AbsoluteUri;
    }
    catch (Exception ex)
    {
        throw new InvalidOperationException(
            $"Failed to resolve endpoint. selectedApiType={selectedApiType}, env={env}. Error: {ex.Message}",
            ex);
    }
}
