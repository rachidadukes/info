private void cmbTransactionType_SelectionChanged(object sender, SelectionChangedEventArgs e)
{
    selectedTransactionType = cmbTransactionType.SelectedItem?.ToString() ?? string.Empty;

    if (string.IsNullOrWhiteSpace(selectedTransactionType))
    {
        txtURL.Text = string.Empty;
        MemberSearchOptionsPanel.Visibility = Visibility.Collapsed;
        return;
    }

    LoadUrlForSelectedTransactionType();

    MemberSearchOptionsPanel.Visibility =
        selectedTransactionType == "Member Search"
            ? Visibility.Visible
            : Visibility.Collapsed;
}


==================

private void LoadUrlForSelectedTransactionType()
{
    string dbPath = "ApiDB.db";

    using var connection = new SQLiteConnection($"Data Source={dbPath};Version=3;");
    connection.Open();

    string sql = @"
        SELECT Endpoint
        FROM URL
        WHERE Type = @Type
          AND Environment = @Environment
          AND ApiType = @ApiType
        LIMIT 1;";

    using var command = new SQLiteCommand(sql, connection);

    command.Parameters.AddWithValue("@Type", selectedTransactionType);
    command.Parameters.AddWithValue("@Environment", SelectedEnvironment);
    command.Parameters.AddWithValue("@ApiType", SelectedAPIType);

    object result = command.ExecuteScalar();

    txtURL.Text = result?.ToString() ?? string.Empty;
}


