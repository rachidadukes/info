async Task LoadAllAccountNumbers()
{
    try
    {
        var result = await Api.GetVerifiedAccountNumbersAsync(
            selectedEnvironment,
            Verified,
            skip: 0,
            take: 50);

        AllAccountNumbers = result.Data
            .Select(x =>
            {
                x.Environment = x.Environment?.Trim().ToUpperInvariant();
                return x;
            })
            .ToList();
    }
    catch (Exception ex)
    {
        ErrorMessage = $"Account numbers load failed: {ex.Message}";
    }
}
