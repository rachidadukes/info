private string GetSelectedMemberSearchType()
{
    if (AccessNbrRadioButton.IsChecked == true)
        return TypeValues.MemberSearchType.MemberSearchAccessNumber;

    if (LastNameRadioButton.IsChecked == true)
        return TypeValues.MemberSearchType.MemberSearchLastName;

    if (SSNRadioButton.IsChecked == true)
        return TypeValues.MemberSearchType.MemberSearchSSN;

    if (AcctNbrRadioButton.IsChecked == true)
        return TypeValues.MemberSearchType.MemberSearchAccount;

    if (BusinessRadioButton.IsChecked == true)
        return TypeValues.MemberSearchType.MemberSearchBusiness;

    return string.Empty;
}
