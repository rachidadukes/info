private async Task<List<TagNameListModel>> ExtractTagNamesFromOneLog(OriginalLogsModel log)
{
    var tags = new List<TagNameListModel>();

    try
    {
        if (log == null || string.IsNullOrWhiteSpace(log.EventDesc))
        {
            Console.WriteLine("Log is null or Log EventDesc is empty.");
            return tags;
        }

        string fullLog = log.EventDesc;

        var matches = Regex.Matches(
            fullLog,
            @"<\s*(?<tag>[A-Za-z_][\w:\.-]*)(?:\s[^>]*)?>[\s\S]*?</\s*\k<tag>\s*>",
            RegexOptions.IgnoreCase
        );

        foreach (Match match in matches)
        {
            string tagName = match.Groups["tag"].Value;

            if (!string.IsNullOrWhiteSpace(tagName))
            {
                tags.Add(new TagNameListModel
                {
                    TagName = tagName
                });
            }
        }

        return tags;
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Unexpected Error in ExtractTagNamesFromOneLog: {ex.Message}");
        return new List<TagNameListModel>();
    }
}
