private async Task<string> GetLegacyResponseAsync()
{
    try
    {
        var client = new MemberTransactionWsClient();

        client.Endpoint.Address = new System.ServiceModel.EndpointAddress(
            "https://unit-dpa-01-plt0.nfcutest.net:5502/NFBranchExService/MemberTransactionService.svc"
        );

        var request = new SearchMemberRq
        {
            MsgRqHdr = new MsgRqHdr_Type
            {
                RqUID = "68f9202e-137f-4d9a-8ac1-6f108e817498",
                EnvironmentName = "UNIT",
                TranCode = "M001",
                BranchId = "D3",
                PCName = "LTCC483A74EAE7",
                TranCodeQual = "0000",
                EmployeeId = "32464",
                PostingDt = "2014-10-23",
                CalendarDt = "2014-10-23",
                TranTime = "08:07:00"
            },
            SearchMemberInfo = new SearchMemberInfo_Type
            {
                CustPermId = "44"
            }
        };

        var response = await client.searchForMemberAsync(request);
        var result = response.SearchMemberRs;

        return result?.ToString() ?? string.Empty;
    }
    catch (System.ServiceModel.FaultException faultEx)
    {
        Console.WriteLine("===== SOAP FAULT =====");
        Console.WriteLine(faultEx.Message);
        return string.Empty;
    }
    catch (System.ServiceModel.CommunicationException ce)
    {
        Console.WriteLine("===== COMMUNICATION ERROR =====");
        Console.WriteLine(ce.Message);
        return string.Empty;
    }
    catch (Exception ex)
    {
        Console.WriteLine("===== UNEXPECTED ERROR =====");
        Console.WriteLine(ex);
        return string.Empty;
    }
}
