private static (List<string> missingFromLeft, List<string> missingFromRight)
    CompareMissingTags(string leftXml, string rightXml)
{
    var leftTags = GetAllElementNames(leftXml);
    var rightTags = GetAllElementNames(rightXml);

    var missingFromLeft = rightTags
        .Where(tag => !leftTags.Contains(tag))
        .OrderBy(tag => tag)
        .ToList();

    var missingFromRight = leftTags
        .Where(tag => !rightTags.Contains(tag))
        .OrderBy(tag => tag)
        .ToList();

    return (missingFromLeft, missingFromRight);
}

private static HashSet<string> GetAllElementNames(string xml)
{
    var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    if (string.IsNullOrWhiteSpace(xml))
        return result;

    try
    {
        var doc = System.Xml.Linq.XDocument.Parse(xml);

        foreach (var element in doc.Descendants())
        {
            result.Add(element.Name.LocalName);
        }
    }
    catch
    {
        // Invalid XML: return empty set.
    }

    return result;
}
