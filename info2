
private readonly HashSet<string> _highlightTags = new()
{
    "EnvironmentName",
    "POAInd",
    "PostingDt",
    "CashBoxId",
    "OverrideCode"
};



========

public FlowDocument FormatXml(string xml)
{
    var doc = new FlowDocument
    {
        FontFamily = new FontFamily("Consolas"),
        FontSize = 13,
        PagePadding = new Thickness(0)
    };

    var paragraph = new Paragraph
    {
        Margin = new Thickness(0),
        LineHeight = 14
    };

    var lines = xml.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

    foreach (var line in lines)
    {
        string trimmed = line.Trim();

        int currentIndex = 0;

        while (currentIndex < trimmed.Length)
        {
            int tagStart = trimmed.IndexOf('<', currentIndex);

            if (tagStart == -1)
            {
                paragraph.Inlines.Add(new Run(trimmed.Substring(currentIndex)));
                break;
            }

            // Add text before tag
            if (tagStart > currentIndex)
            {
                paragraph.Inlines.Add(new Run(trimmed.Substring(currentIndex, tagStart - currentIndex)));
            }

            int tagEnd = trimmed.IndexOf('>', tagStart);

            if (tagEnd == -1)
            {
                paragraph.Inlines.Add(new Run(trimmed.Substring(tagStart)));
                break;
            }

            string tag = trimmed.Substring(tagStart, tagEnd - tagStart + 1);

            // Extract tag name (remove </ >)
            string tagName = tag
                .Replace("<", "")
                .Replace(">", "")
                .Replace("/", "")
                .Trim();

            Run tagRun;

            if (_highlightTags.Contains(tagName))
            {
                tagRun = new Run(tag)
                {
                    Foreground = Brushes.Red,
                    FontWeight = FontWeights.Bold
                };
            }
            else
            {
                tagRun = new Run(tag)
                {
                    Foreground = Brushes.Blue // optional: normal XML tag color
                };
            }

            paragraph.Inlines.Add(tagRun);

            currentIndex = tagEnd + 1;
        }

        paragraph.Inlines.Add(new LineBreak());
    }

    doc.Blocks.Clear();
    doc.Blocks.Add(paragraph);

    return doc;
}
