private string _selectedMemberSearchType =
    TypeValues.MemberSearchType.MemberSearchAccessNumber;

private void MemberSearchTypeRadioButton_Checked(
    object sender,
    RoutedEventArgs e)
{
    if (sender == AccessNbrRadioButton)
    {
        _selectedMemberSearchType =
            TypeValues.MemberSearchType.MemberSearchAccessNumber;
    }
    else if (sender == LastNameRadioButton)
    {
        _selectedMemberSearchType =
            TypeValues.MemberSearchType.MemberSearchLastName;
    }
    else if (sender == SSNRadioButton)
    {
        _selectedMemberSearchType =
            TypeValues.MemberSearchType.MemberSearchSSN;
    }
    else if (sender == AcctNbrRadioButton)
    {
        _selectedMemberSearchType =
            TypeValues.MemberSearchType.MemberSearchAccount;
    }
    else if (sender == BusinessRadioButton)
    {
        _selectedMemberSearchType =
            TypeValues.MemberSearchType.MemberSearchBusiness;
    }

    LoadRequests();
}

